{
  "$schema": "../../asset/contracts/asset-consumer-declaration.schema.json",
  "consumerKey": "docs",
  "namespaceKey": "docs",
  "displayName": "月离文档",
  "bindings": [
    { "kind": "oauth-client", "subject": "docs-main-web" },
    { "kind": "service-client", "subject": "docs-asset-svc" }
  ],
  "referenceLifecycle": {"complete": true, "strategy": "snapshot", "coverage": "启动及每15秒以当前文档和合集封面快照登记；覆盖导入、GitHub同步、编辑、克隆、删除及恢复，草稿和归档保留；失败保留并重试。"},
  "profiles": [
    {
      "key": "docs-collection-cover",
      "kind": "public-image",
      "purpose": "文档集封面",
      "allowedMimes": ["image/jpeg", "image/png", "image/webp"],
      "maxBytes": 10485760,
      "maxPixels": 30000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": true,
      "storageClass": "public-media",
      "variants": [
        { "key": "cover", "width": 256, "height": 256, "mode": "fill", "format": "webp", "quality": 85, "visibility": "public", "metadataPolicy": "strip" }
      ]
    },
    {
      "key": "docs-content-image",
      "kind": "public-image",
      "purpose": "文档正文图片",
      "allowedMimes": ["image/webp", "image/gif"],
      "maxBytes": 10485760,
      "maxPixels": 30000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": false,
      "storageClass": "public-media",
      "variants": [
        { "key": "inline", "width": 900, "height": 900, "mode": "resize-width", "format": "webp", "quality": 84, "visibility": "public", "metadataPolicy": "strip" },
        { "key": "content", "width": 1200, "height": 1200, "mode": "resize-width", "format": "webp", "quality": 88, "visibility": "public", "metadataPolicy": "strip" }
      ]
    },
    {
      "key": "docs-import-image",
      "kind": "public-image",
      "purpose": "文档包导入图片",
      "allowedMimes": ["image/jpeg", "image/png", "image/webp", "image/gif"],
      "maxBytes": 10485760,
      "maxPixels": 80000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": false,
      "storageClass": "public-media",
      "variants": [
        { "key": "inline", "width": 900, "height": 900, "mode": "resize-width", "format": "webp", "quality": 84, "visibility": "public", "metadataPolicy": "strip" },
        { "key": "content", "width": 1200, "height": 1200, "mode": "resize-width", "format": "webp", "quality": 88, "visibility": "public", "metadataPolicy": "strip" }
      ]
    }
  ]
}
