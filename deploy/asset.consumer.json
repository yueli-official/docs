{
  "$schema": "../../asset/contracts/asset-consumer-declaration.schema.json",
  "consumerKey": "docs",
  "namespaceKey": "docs",
  "displayName": "月离文档",
  "bindings": [
    { "kind": "oauth-client", "subject": "docs-main-web" },
    { "kind": "service-client", "subject": "docs-asset-svc" }
  ],
  "profiles": [
    {
      "key": "docs-collection-cover",
      "kind": "public-image",
      "purpose": "文档集封面",
      "allowedMimes": ["image/jpeg", "image/png", "image/webp"],
      "maxBytes": 10485760,
      "maxPixels": 30000000,
      "visibility": "public",
      "metadataPolicy": "strip",
      "keepOriginal": true,
      "storageClass": "public-media",
      "variants": [
        { "key": "cover", "width": 800, "height": 600, "mode": "fill", "format": "webp", "quality": 85, "visibility": "public", "metadataPolicy": "strip" }
      ]
    }
  ]
}
