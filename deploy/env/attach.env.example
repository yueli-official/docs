# Existing Identity and Asset; only Docs and its PostgreSQL are managed.
DOCS_POSTGRES_USER=docs
DOCS_POSTGRES_PASSWORD=
DOCS_POSTGRES_DB=docs
DOCS_DATABASE_URL=postgres://docs:${DOCS_POSTGRES_PASSWORD}@docs-postgres:5432/docs?sslmode=disable
DOCS_API_PORT=8086
DOCS_WEB_PORT=3003
DOCS_PUBLIC_ORIGIN=http://localhost:3003
DOCS_SITE_KEY=docs-main
DOCS_SITE_BRAND=月离文档
DOCS_SITE_DOMAIN=docs.localhost
DOCS_SITE_DESCRIPTION=指南、参考与教程
DOCS_WEB_SEAL_SECRET=
DOCS_COOKIE_SECURE=false
DOCS_ADMIN_SUB=
DOCS_BOOTSTRAP_ADMIN_SUBS=["${DOCS_ADMIN_SUB}"]

DOCS_IDENTITY_ISSUER=https://identity.example.com
DOCS_IDENTITY_INTERNAL_URL=https://identity.example.com
DOCS_IDENTITY_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
DOCS_IDENTITY_JWKS_URL=https://identity.example.com/oauth2/jwks.json
DOCS_ACCOUNT_ORIGIN=https://account.example.com
DOCS_OIDC_CLIENT_ID=docs-main-web
DOCS_OIDC_REDIRECT_URI=http://localhost:3003/auth/callback
DOCS_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3003/
DOCS_ALLOW_LOOPBACK_IDENTITY_HTTP=false
DOCS_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false

DOCS_ASSET_INTERNAL_URL=https://asset.example.com
DOCS_ASSET_SPACE=yueli
DOCS_ASSET_NAMESPACE=docs-main
DOCS_ASSET_PROFILE=docs-collection-cover
DOCS_BINDING_ALLOW_INSECURE_ASSET_HTTP=false

DOCS_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
