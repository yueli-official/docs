# Docs complete standalone topology.
DOCS_POSTGRES_USER=docs
DOCS_POSTGRES_PASSWORD=
DOCS_POSTGRES_DB=docs
DOCS_DATABASE_URL=postgres://docs:${DOCS_POSTGRES_PASSWORD}@docs-postgres:5432/docs?sslmode=disable
DOCS_API_PORT=8086
DOCS_WEB_PORT=3003
DOCS_PUBLIC_ORIGIN=http://localhost:3003
DOCS_SITE_KEY=docs-main
DOCS_SITE_BRAND=月离文档
DOCS_SITE_DOMAIN=docs.localhost
DOCS_SITE_DESCRIPTION=指南、参考与教程
DOCS_WEB_SEAL_SECRET=
DOCS_COOKIE_SECURE=false

DOCS_ADMIN_SUB=
DOCS_ADMIN_EMAIL=
DOCS_ADMIN_PASSWORD=
DOCS_ADMIN_DISPLAY_NAME=Docs Administrator
DOCS_BOOTSTRAP_ADMIN_SUBS=["${DOCS_ADMIN_SUB}"]

IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_DB=identity
IDENTITY_DATABASE_URL=postgres://identity:${IDENTITY_POSTGRES_PASSWORD}@identity-postgres:5432/identity?sslmode=disable
IDENTITY_GLOBAL_SECRET=
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]
IDENTITY_ALLOW_PRIVATE_HTTP_REDIRECTS=false
DOCS_IDENTITY_ISSUER=http://localhost:8081
DOCS_IDENTITY_INTERNAL_URL=http://identity:8081
DOCS_IDENTITY_DISCOVERY_URL=https://identity-internal:8443/.well-known/openid-configuration
DOCS_IDENTITY_JWKS_URL=https://identity-internal:8443/oauth2/jwks.json
DOCS_ACCOUNT_ORIGIN=http://localhost:3000
DOCS_OIDC_CLIENT_ID=docs-main-web
DOCS_OIDC_REDIRECT_URI=http://localhost:3003/auth/callback
DOCS_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3003/
DOCS_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
DOCS_ALLOW_LOOPBACK_IDENTITY_HTTP=false

ASSET_POSTGRES_USER=asset
ASSET_POSTGRES_PASSWORD=
ASSET_POSTGRES_DB=asset
ASSET_DATABASE_URL=postgres://asset:${ASSET_POSTGRES_PASSWORD}@asset-postgres:5432/asset?sslmode=disable
ASSET_UPLOAD_SECRET=
ASSET_STORAGE_CONFIG_SECRET=
ASSET_PORT=8082
DOCS_ASSET_INTERNAL_URL=http://asset:8082
DOCS_ASSET_PUBLIC_ORIGIN=http://localhost:8082
DOCS_ASSET_SPACE=yueli
DOCS_ASSET_NAMESPACE=docs-main
DOCS_ASSET_PROFILE=docs-collection-cover
DOCS_ASSET_CLIENT_ID=docs-asset-svc
DOCS_ASSET_CLIENT_SECRET=
DOCS_ASSET_SCOPE=asset:sign
DOCS_BINDING_ALLOW_INSECURE_ASSET_HTTP=true
ASSET_ALLOW_LOOPBACK_IDENTITY_HTTP=false

DOCS_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
